{
    "version": 2,
    "builds": [
        {
            "src": "index.php",
            "use": "@vercel/php"
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/(.*)",
            "dest": "index.php"
        }
    ]
}